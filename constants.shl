EMPTY = 0
PAWN = 1
KNIGHT = 2
BISHOP = 3
ROOK = 4
QUEEN = 5
KING = 6

WHITE = 8
BLACK = 16

A8 = 0
B8 = 1
C8 = 2
D8 = 3
E8 = 4
F8 = 5
G8 = 6
H8 = 7

A1 = 56
B1 = 57
C1 = 58
D1 = 59
E1 = 60
F1 = 61
G1 = 62
H1 = 63

to get_piece_color p
    if p == EMPTY
        give 0
    if p < BLACK
        give WHITE
    else
        give BLACK

to get_piece_type p
    if p == EMPTY
        give EMPTY
    if p < BLACK
        give p - WHITE
    else
        give p - BLACK