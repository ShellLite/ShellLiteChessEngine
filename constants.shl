EMPTY = 0
PAWN = 1
KNIGHT = 2
BISHOP = 3
ROOK = 4
QUEEN = 5
KING = 6

WHITE = 8
BLACK = 16

A8 = 0
B8 = 1
C8 = 2
D8 = 3
E8 = 4
F8 = 5
G8 = 6
H8 = 7

A1 = 56
B1 = 57
C1 = 58
D1 = 59
E1 = 60
F1 = 61
G1 = 62
H1 = 63

to get_piece_color p
    if p == EMPTY
        give 0
    if p < BLACK
        give WHITE
    give BLACK

to get_piece_type p
    if p == EMPTY
        give EMPTY
    if p < BLACK
        give p - WHITE
    give p - BLACK

lcg_state = [123456789]
to next_random
    lcg_state[0] = lcg_state[0] * 6364136223846793005 + 1442695040888963407
    give lcg_state[0]

ZOBRIST_PIECES = []
ZOBRIST_TURN = []
ZOBRIST_CASTLING = []
ZOBRIST_EP = []

to init_zobrist
    repeat 1472 times
        r_val = next_random()
        add r_val to ZOBRIST_PIECES
    
    r_val = next_random()
    add r_val to ZOBRIST_TURN

    repeat 4 times
        r_val = next_random()
        add r_val to ZOBRIST_CASTLING
    
    repeat 8 times
        r_val = next_random()
        add r_val to ZOBRIST_EP

