use "constants.shl"
use "moves.shl"

to square_to_str sq
    r = int(sq / 8)
    c = sq % 8
    f = char(ord("a") + c)
    rank = str(8 - r)
    give f + rank

to move_to_str move
    give square_to_str(move.from_sq) + square_to_str(move.to_sq)

